{
  "name": "teyvat-region-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.12.0"
  },
  "description": "原神 7.2 分层瓦片地图与区域音乐试听。",
  "scripts": {
    "data": "node scripts/build-map-data.mjs",
    "tiles": "node scripts/build-layer-base.mjs && node scripts/build-tile-pyramid.mjs",
    "layers": "node scripts/build-layer-data.mjs",
    "music": "node scripts/build-bgm-playlists.mjs",
    "audio:extract": "node scripts/extract-bgm-audio.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/package-static-assets.mjs",
    "build:hosted": "node scripts/build-hosted.mjs",
    "export:site": "node scripts/export-static-site.mjs",
    "preview": "vite preview",
    "verify": "node scripts/verify-headless.mjs",
    "verify:external": "node scripts/verify-external-audio.mjs"
  },
  "dependencies": {
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "geos-wasm": "3.1.1",
    "puppeteer-core": "23.11.1",
    "sharp": "0.35.0",
    "vite": "6.3.5"
  }
}
